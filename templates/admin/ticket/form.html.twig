{% extends 'base.html.twig' %}

{% block title %}{{ titre }} – Administration{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 card-title">{{ titre }}</h1>

                {{ form_start(form) }}
                    {{ form_row(form.auteur) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.categorie) }}
                    {{ form_row(form.etat) }}
                    {{ form_row(form.responsable) }}
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path('app_admin_tickets') }}" class="btn btn-outline-secondary">Retour</a>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
