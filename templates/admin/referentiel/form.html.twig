{% extends 'base.html.twig' %}

{% block title %}{{ titre }} – Administration{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 card-title">{{ titre }}</h1>

                {{ form_start(form) }}
                    {{ form_row(form) }}
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path(routeRetour) }}" class="btn btn-outline-secondary">Retour</a>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
