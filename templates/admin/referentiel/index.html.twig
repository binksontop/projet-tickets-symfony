{% extends 'base.html.twig' %}

{% block title %}{{ titre }} – Administration{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">{{ titre }}</h1>
    <a href="{{ path(nomRoute ~ '_new') }}" class="btn btn-primary">Nouveau</a>
</div>

<table class="table table-hover bg-white shadow-sm">
    <thead>
        <tr>
            <th>N°</th>
            <th>Libellé</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for entite in entites %}
            <tr>
                <td>{{ entite.id }}</td>
                <td>{{ entite }}</td>
                <td>
                    <a href="{{ path(nomRoute ~ '_edit', {id: entite.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                    <form method="post" action="{{ path(nomRoute ~ '_delete', {id: entite.id}) }}" class="d-inline"
                          onsubmit="return confirm('Voulez-vous vraiment supprimer cet élément ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('suppression' ~ entite.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3" class="text-center text-muted">Aucun élément pour le moment.</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
